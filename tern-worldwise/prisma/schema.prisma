// This is your Prisma schema file

// *────────────────────────────────
// * LEARN: beschreibt Datenstruktur in der DB
// *────────────────────────────────

// ===== Defauls =====
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")          
  directUrl = env("DATABASE_URL_UNPOOLED")    
}

// ===== Enums =====
enum Category {
  history
  geography
  culture
  nature
}

enum CreatedBy {
  system
  user
}

enum ModerationStatus {
  approved
  pending
  rejected
}

// *────────────────────────────────
// * LEARN: model beschreibt Tabelle in der DB
// * user tabelle wird später über prisma.user aufgerufen (Singular, klein geschrieben)
// *────────────────────────────────

// ===== Models =====
model Question {
  id            String            @id @default(cuid())
  category      Category
  question      String
  answers       String[]          // Postgres-Array, z.B. ["A","B","C"]
  correctIndex  Int               // Index in 'answers' (0-basiert – im Code validieren)
  // location
  lat           Float             // z.B. 52.5200
  lng           Float             // z.B. 13.4050
  country       String            // ISO-Name oder Exonym (z.B. "Deutschland")
  fact          String

  createdBy     CreatedBy         @default(system)
  // Optionaler Autor, falls createdBy = user
  createdByUserId String?         
  createdByUser   User?           @relation(fields: [createdByUserId], references: [id])

  status        ModerationStatus  @default(pending)
  createdAt     DateTime          @default(now()) // entspricht deinem dateAdded

  // Indizes für häufige Filter
  @@index([category])
  @@index([status])
  @@index([country])
  @@index([createdAt])
  // optional: schnelleres Sortieren/Suchen im Titel
  @@index([question])
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  questions Question[] // vom User eingereichte Fragen
  createdAt DateTime   @default(now())
}